# SANDBOX_API_BASE: dev/sandbox can point to https://iruidong.com/v1; prod is customer-managed.
SANDBOX_API_BASE=YOUR_SANDBOX_API_BASE_HERE
# RUIDONG_API_KEY: never commit the real value.
RUIDONG_API_KEY=YOUR_KEY_HERE
# HARNESS_ENV: one of dev, sandbox, prod.
HARNESS_ENV=YOUR_HARNESS_ENV_HERE
# HARNESS_DEFAULT_MODEL: keep configurable per deployment.
HARNESS_DEFAULT_MODEL=YOUR_DEFAULT_MODEL_HERE
